# Copy to .env.local to point the dev proxy at different backend URLs.
# Defaults are the HTTPS ports of each ASP.NET Core project's "https" launch profile
# (plain HTTP ports 5101 / 5056 / 5160 redirect to these because of UseHttpsRedirection).
AUTH_API_URL=https://localhost:7113
EMPLOYEE_API_URL=https://localhost:7181
LEAVE_API_URL=https://localhost:7299
