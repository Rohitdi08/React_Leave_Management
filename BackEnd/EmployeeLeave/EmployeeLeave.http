@EmployeeLeave_HostAddress = http://localhost:5056
# Paste the Accesstoken returned by Auth1: POST http://localhost:5101/api/Auth/Login
@token = PASTE_ACCESS_TOKEN_HERE

GET {{EmployeeLeave_HostAddress}}/api/employee
Accept: application/json
Authorization: Bearer {{token}}

###

GET {{EmployeeLeave_HostAddress}}/api/employee/1
Accept: application/json
Authorization: Bearer {{token}}

